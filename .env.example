# Copy to `.env` and fill in. `.env` is gitignored.
#
# Grab from your AIAAS credentials vault:
#   Credentials -> "OpenRouter API" -> field `apiKey`
# Or generate a fresh one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic key only needed if you also want to run the legacy
# claude-direct gap-filler at src/llm_gap_fill.py. Not required for the
# decipher pipeline (Claude readings go through Claude Code subscription).
# ANTHROPIC_API_KEY=sk-ant-...

# Scholar stage (src/scholar/) — OpenAI Agents SDK over OpenRouter.
# Both default to sensible vision/text models if unset:
#   strip agent  default: anthropic/claude-opus-4
#   segment agent default: openai/gpt-4o
# SCHOLAR_STRIP_MODEL=anthropic/claude-opus-4
# SCHOLAR_SEGMENT_MODEL=openai/gpt-4o
